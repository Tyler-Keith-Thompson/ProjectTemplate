# Agent worktrees are checkouts of this same repo.
.claude/worktrees/

# Bazel
/bazel-*
/user.bazelrc
# Remote cache diagnostics (user.bazelrc may write them).
/bazel-remote-grpc.log
/execution_log.binpb.zst
.cache/

# SwiftPM
.build/
.swiftpm/
# The root package is a library, so its resolution is not committed; swift/Package.resolved
# pins Bazel's dependencies and is.
/Package.resolved

# Xcode (generated from the Bazel graph by `just generate`)
/ProjectName.xcodeproj/
xcuserdata/

# embedded:begin
# ESP-IDF: the build, downloaded components, and the full configuration it expands from
# Firmware/sdkconfig.defaults (`just menuconfig` saves changes there).
/Firmware/build/
/Firmware/managed_components/
/Firmware/sdkconfig
/Firmware/sdkconfig.old
# embedded:end

# macOS
.DS_Store

# Python
__pycache__/

# benchmarks:begin
# Benchmark baselines: `main` (just bench-baseline) and `simulated` (just bench-simulated) are shared;
# other names are local before/after comparisons.
Benchmarks/.benchmarkBaselines/*/*
!Benchmarks/.benchmarkBaselines/*/main/
!Benchmarks/.benchmarkBaselines/*/simulated/
# benchmarks:end

# fuzz:begin
# Fuzzing (see Fuzz/README.md): the corpus is a local cache; a crash becomes a test, then goes.
/Fuzz/Corpus/
/Fuzz/Crashes/
# fuzz:end

# differential:begin
# Differential failures (see Differential/README.md): each becomes a test, then goes.
/Differential/Failures/
# differential:end

# explore:begin
# The explorer's build output (just explore).
/Explore/dist/
# explore:end
*.swp
