# Agent worktrees are checkouts of this same repo, so `//...` would otherwise expand into every one.
.claude

# SwiftPM build directories can contain BUILD files, which Bazel would otherwise try to load.
.build
.swiftpm
swift/.build
swift/.swiftpm

# Convenience symlinks.
bazel-ProjectName
bazel-bin
bazel-out
bazel-testlogs

# benchmarks:begin
# The benchmark package is SwiftPM-only.
Benchmarks
# benchmarks:end

# fuzz:begin
# The fuzz package builds with SwiftPM.
Fuzz/.build
# fuzz:end

# differential:begin
# The differential package's SwiftPM build (`just diff --swiftpm`).
Differential/.build
# differential:end

# explore:begin
# The browser explorer is a SwiftPM package; its build directory can contain BUILD files.
Explore
# explore:end

# Overlays the bootstrap script copies over the template (server type); not built in place.
templates
