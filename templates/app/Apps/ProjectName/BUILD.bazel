load("@rules_apple//apple:apple.bzl", "local_provisioning_profile")
load("@rules_apple//apple:ios.bzl", "ios_application")
load("//tools:swift_rules.bzl", "swift_library")

# The app's own code: the composition root and nothing a test needs to reach.
swift_library(
    name = "ProjectNameAppLibrary",
    srcs = glob(["**/*.swift"]),
    module_name = "ProjectNameApp",
    target_compatible_with = ["@platforms//os:ios"],
    deps = [
        "//Sources/GreetingFeature",
        # The debug drawer and the plugins the app installs (ProjectNameApp.swift). Add a plugin's
        # product here and its install call there; release builds compile all of it to no-ops.
        "@swiftpkg_debugdrawer//:DebugDrawer",
        "@swiftpkg_debugdrawer//:DebugDrawerAppInfoPlugin",
        "@swiftpkg_debugdrawer//:DebugDrawerConsolePlugin",
        "@swiftpkg_debugdrawer//:DebugDrawerPerformancePlugin",
        "@swiftpkg_debugdrawer//:DebugDrawerUserDefaultsPlugin",
    ],
)

# `just run` launches it in the simulator (.bazelrc picks the device); `just phone-install` on an
# iPhone. Keep bundle_id in step with PHONE_BUNDLE_ID in the justfile and the app
# profile's name below.
ios_application(
    name = "ProjectName",
    bundle_id = "com.example.projectname",
    families = ["iphone"],
    infoplists = ["Info.plist"],
    minimum_os_version = "18.0",
    # The simulator runs apps unsigned.
    provisioning_profile = select({
        ":device_wildcard_profile": ":wildcard_provisioning_profile",
        "@build_bazel_apple_support//constraints:device": ":provisioning_profile",
        "//conditions:default": None,
    }),
    visibility = [
        "//Apps/ProjectNameSmokeTests:__pkg__",
        "@rules_xcodeproj//xcodeproj:generated",
    ],
    deps = [":ProjectNameAppLibrary"],
)

# Signed for development on your own devices, never distributed. Xcode's automatic signing creates
# or updates a profile and adds each iPhone to it (`just phone-provision`, once per new iPhone);
# Bazel signs device builds with it. Xcode makes the bundle identifier's profile, unless the team
# already has its wildcard one and the app needs no capability, when it signs with that instead.
# `just phone-install` asks tools/iphone/signing-profile.sh which of the two holds the iPhone and
# passes it as --define=signing_profile=app or wildcard. Each is found by name alone, so no team
# ID is committed; give them a team_id only if two of your teams hold a profile of that name.
# (rules_xcodeproj's xcode_provisioning_profile is left out: it requires a team ID.)
local_provisioning_profile(
    name = "provisioning_profile",
    profile_name = "iOS Team Provisioning Profile: com.example.projectname",
    tags = ["manual"],
)

local_provisioning_profile(
    name = "wildcard_provisioning_profile",
    profile_name = "iOS Team Provisioning Profile: *",
    tags = ["manual"],
)

# A device build given --define=signing_profile=wildcard. It specializes the device constraint, so
# the select above takes it over that one.
config_setting(
    name = "device_wildcard_profile",
    constraint_values = ["@build_bazel_apple_support//constraints:device"],
    define_values = {"signing_profile": "wildcard"},
)
